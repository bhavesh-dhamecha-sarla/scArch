<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores child records of payment breakdowns/installments.</description>
    <nameField>
        <displayFormat>PD-{00000}</displayFormat>
        <label>Payment Detail Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Payment Details</pluralLabel>
    <sharingModel>ControlledByParent</sharingModel><!-- 1. Master-Detail Relationship to Payment_Info__c --><!-- 2. Detail Type --><!-- 3. Amount --><!-- 4. Due Date --><!-- 5. Paid Date --><!-- 6. Late Fee Applied --><!-- 7. Late Fee Amount --><!-- 8. Discount Applied --><!-- 9. Net Amount --><!-- 10. Detail External ID -->
    <fields>
        <fullName>Payment_Info__c</fullName>
        <label>Payment Info</label>
        <type>MasterDetail</type>
        <referenceTo>Payment_Info__c</referenceTo>
        <relationshipLabel>Payment Details</relationshipLabel>
        <relationshipName>Payment_Details</relationshipName>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Detail_Type__c</fullName>
        <label>Detail Type</label>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Installment</fullName>
                    <default>false</default>
                </value>
                <value>
                    <fullName>Full</fullName>
                    <default>true</default>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Amount__c</fullName>
        <label>Amount</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Due_Date__c</fullName>
        <label>Due Date</label>
        <type>Date</type>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Paid_Date__c</fullName>
        <label>Paid Date</label>
        <type>Date</type>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Late_Fee_Applied__c</fullName>
        <label>Late Fee Applied</label>
        <type>Checkbox</type>
        <defaultValue>false</defaultValue>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Late_Fee_Amount__c</fullName>
        <label>Late Fee Amount</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Discount_Applied__c</fullName>
        <label>Discount Applied</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Net_Amount__c</fullName>
        <label>Net Amount</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Detail_External_ID__c</fullName>
        <label>Detail External ID</label>
        <type>Text</type>
        <length>50</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <externalId>true</externalId>
        <unique>true</unique>
    </fields>
</CustomObject>
