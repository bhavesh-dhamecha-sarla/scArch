    <visibility>Public</visibility>
    <fields>
        <fullName>Archive_Children__c</fullName>
        <description>Indicates whether child records should be archived with the parent record</description>
        <defaultValue>false</defaultValue>
        <label>Archive Child Records</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Archive_Frequency__c</fullName>
        <label>Archive Frequency</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Daily</fullName>
                    <default>false</default>
                    <label>Daily</label>
                </value>
                <value>
                    <fullName>Weekly</fullName>
                    <default>false</default>
                    <label>Weekly</label>
                </value>
                <value>
                    <fullName>Monthly</fullName>
                    <default>false</default>
                    <label>Monthly</label>
                </value>
                <value>
                    <fullName>2 Months</fullName>
                    <default>false</default>
                    <label>2 Months</label>
                </value>
                <value>
                    <fullName>3 Months</fullName>
                    <default>false</default>
                    <label>3 Months</label>
                </value>
                <value>
                    <fullName>6 Months</fullName>
                    <default>false</default>
                    <label>6 Months</label>
                </value>
                <value>
                    <fullName>Yearly</fullName>
                    <default>false</default>
                    <label>Yearly</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Field_Set_Name__c</fullName>
        <description>To dictate which fields display in the LWC tabular format.</description>
        <externalId>false</externalId>
        <label>Field Set Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
